{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Horse Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "imagePath",
    "hitbox"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "imagePath": {
      "type": "string"
    },
    "hitbox": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/vec"
      }
    }
  },
  "$defs": {
    "vec": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  }
}